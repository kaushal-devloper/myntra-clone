{
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
          {
                  "source": "/api/:path*",
                  "destination": "/api"
          },
          {
                  "source": "/product/:path*",
                  "destination": "/api"
          },
          {
                  "source": "/category/:path*",
                  "destination": "/api"
          },
          {
                  "source": "/((?!assets/|static/|_expo/|.*\\..*$).*)",
                  "destination": "/index.html"
          }
    ]
}
